<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Virtual Snowball Toss - Counseling & SEL Activity</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 40%, #0f172a 100%);
            min-height: 100vh;
            color: #f8fafc;
        }

        .handwritten {
            font-family: 'Caveat', cursive;
        }

        .paper-card {
            background-color: #fafaf9;
            background-image: radial-gradient(#d6d3d1 0.75px, transparent 0.75px);
            background-size: 12px 12px;
            color: #1c1917;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5), 0 8px 10px -6px rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }

        .paper-crumpled {
            animation: crumple 0.8s cubic-bezier(0.68, -0.55, 0.265, 1.55) forwards;
        }

        @keyframes crumple {
            0% { transform: scale(1) rotate(0deg); border-radius: 12px; }
            40% { transform: scale(0.6) rotate(15deg); border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%; filter: contrast(1.2) brightness(0.9); }
            80% { transform: scale(0.2) rotate(-30deg); border-radius: 50%; filter: contrast(1.8) brightness(0.7); }
            100% { transform: scale(0) rotate(180deg); opacity: 0; }
        }

        .paper-unfold {
            animation: unfold 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
        }

        @keyframes unfold {
            0% { transform: scale(0.1) rotate(-180deg); opacity: 0; filter: blur(8px); }
            100% { transform: scale(1) rotate(0deg); opacity: 1; filter: blur(0px); }
        }

        .bowl-shadow {
            box-shadow: inset 0 -15px 25px rgba(0,0,0,0.4), 0 20px 35px -10px rgba(0,0,0,0.6);
        }

        .glass-panel {
            background: rgba(30, 41, 59, 0.75);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .glass-pill {
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.12);
        }
    </style>
</head>
<body class="flex flex-col min-h-screen relative overflow-x-hidden">

    <header class="w-full py-3 px-4 md:px-8 flex items-center justify-between border-b border-slate-800 bg-slate-900/80 backdrop-blur-md sticky top-0 z-50">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-cyan-500 to-indigo-500 flex items-center justify-center text-white shadow-lg shadow-cyan-500/20">
                <i class="ph-bold ph-snowflake text-2xl"></i>
            </div>
            <div>
                <h1 class="font-extrabold text-base md:text-lg text-white tracking-tight leading-none">Virtual Snowball Toss</h1>
                <p class="text-xs text-slate-400 font-medium mt-0.5" id="header-subtitle">Graduate SEL & Counseling Toolkit</p>
            </div>
        </div>

        <div id="room-status-bar" class="hidden flex items-center gap-3">
            <div class="glass-pill px-3 py-1.5 rounded-full text-xs font-semibold flex items-center gap-2 text-slate-200">
                <span id="live-indicator-dot" class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>Room: <strong id="header-room-code" class="font-mono text-cyan-400 text-sm tracking-wider">----</strong></span>
            </div>
            <button id="leave-room-btn" onclick="leaveSession()" class="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition-colors text-xs flex items-center gap-1" title="Leave Session">
                <i class="ph-bold ph-sign-out text-base"></i>
                <span class="hidden sm:inline">Exit</span>
            </button>
        </div>
    </header>

    <!-- Sandbox Notification Banner -->
    <div id="sandbox-banner" class="hidden bg-amber-500/20 border-b border-amber-500/30 text-amber-200 px-4 py-2 text-xs text-center font-medium flex items-center justify-center gap-2">
        <i class="ph-bold ph-warning text-base"></i>
        <span>Offline Sandbox Mode (Firebase connection inactive). Single-player simulation enabled.</span>
    </div>

    <main class="flex-1 max-w-4xl w-full mx-auto p-4 md:p-8 flex flex-col justify-center items-center relative z-10">

        <!-- LOBBY / ROOM SELECTION -->
        <section id="lobby-view" class="w-full max-w-md transition-all duration-300">
            <div class="text-center mb-6">
                <span class="px-3 py-1 bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 rounded-full text-xs font-bold uppercase tracking-wider mb-2 inline-block">Counseling & Group SEL</span>
                <h2 class="text-2xl md:text-3xl font-extrabold text-white tracking-tight">Virtual Snowball Toss</h2>
                <p class="text-slate-400 text-xs md:text-sm mt-1">An anonymous externalization activity for building psychological safety, universalizing anxieties, and peer empathy.</p>
            </div>

            <div class="glass-panel rounded-2xl p-6 shadow-2xl space-y-5">
                <!-- Join Room Form -->
                <div class="space-y-3">
                    <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider">Join Existing Session</label>
                    <div class="flex gap-2">
                        <input type="text" id="join-code-input" maxlength="4" placeholder="ROOM CODE" class="flex-1 p-3 rounded-xl bg-slate-900/90 border border-slate-700 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-500/20 uppercase font-mono tracking-widest text-center font-bold text-white placeholder-slate-500 text-sm">
                        <button onclick="joinRoomFromInput()" class="px-5 py-3 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold rounded-xl shadow-lg shadow-cyan-500/20 transition-all text-sm flex items-center gap-1.5">
                            <span>Join</span>
                            <i class="ph-bold ph-arrow-right"></i>
                        </button>
                    </div>
                </div>

                <div class="relative flex py-1 items-center">
                    <div class="flex-grow border-t border-slate-700"></div>
                    <span class="flex-shrink mx-3 text-slate-500 text-xs uppercase font-bold">Or</span>
                    <div class="flex-grow border-t border-slate-700"></div>
                </div>

                <!-- Host Room Action -->
                <button onclick="createRoom()" class="w-full py-3.5 bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-400 hover:to-purple-500 text-white font-bold rounded-xl shadow-lg shadow-indigo-500/20 transition-all text-sm flex items-center justify-center gap-2">
                    <i class="ph-bold ph-chalkboard-teacher text-lg"></i>
                    <span>Create Host Session (Counselor / Facilitator)</span>
                </button>

                <button onclick="startSandboxMode()" class="w-full py-2.5 bg-slate-800/80 hover:bg-slate-700 text-slate-300 font-semibold rounded-xl transition-all text-xs flex items-center justify-center gap-1.5 border border-slate-700">
                    <i class="ph-bold ph-play text-sm"></i>
                    <span>Launch Local Sandbox Demo</span>
                </button>
            </div>
        </section>

        <section id="host-view" class="hidden w-full transition-all duration-300">
            <div class="glass-panel rounded-2xl p-6 shadow-2xl mb-6">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-slate-700/80">
                    <div>
                        <span class="px-2.5 py-0.5 bg-purple-500/20 text-purple-300 border border-purple-500/30 rounded-full text-xs font-bold uppercase tracking-wider">Facilitator Dashboard</span>
                        <h2 class="text-2xl font-extrabold text-white mt-1">Room Code: <span id="host-code-display" class="font-mono text-cyan-400 tracking-widest">----</span></h2>
                        <p class="text-xs text-slate-400">Share code with group members. Real-time participant counters sync automatically.</p>
                    </div>

                    <!-- Live Sync Counters -->
                    <div class="flex items-center gap-3">
                        <div class="bg-slate-900/80 px-4 py-2.5 rounded-xl border border-slate-700 text-center min-w-[90px]">
                            <span class="block text-2xl font-extrabold text-cyan-400 leading-none" id="host-participants-count">0</span>
                            <span class="text-[10px] font-bold uppercase text-slate-400 tracking-wider">Connected</span>
                        </div>
                        <div class="bg-slate-900/80 px-4 py-2.5 rounded-xl border border-slate-700 text-center min-w-[90px]">
                            <span class="block text-2xl font-extrabold text-emerald-400 leading-none" id="host-submitted-count">0</span>
                            <span class="text-[10px] font-bold uppercase text-slate-400 tracking-wider">Submitted</span>
                        </div>
                    </div>
                </div>

                <!-- Host Controls & Activity Pipeline Stepper -->
                <div class="mt-6">
                    <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">Activity Stage Controller (Broadcasting Live)</h3>
                    <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
                        <button id="stage-btn-SUBMISSION" onclick="hostUpdateStage('SUBMISSION')" class="p-3.5 rounded-xl border-2 text-left transition-all bg-indigo-600/30 border-indigo-500 text-indigo-200">
                            <span class="text-[10px] font-extrabold block uppercase tracking-wider text-indigo-400">Stage 1</span>
                            <span class="font-bold text-sm block mt-0.5">1. Collect Notes</span>
                            <span class="text-[11px] text-slate-400 mt-1 block">Participants submit thoughts</span>
                        </button>

                        <button id="stage-btn-MIXING" onclick="hostUpdateStage('MIXING')" class="p-3.5 rounded-xl border-2 text-left transition-all bg-slate-800/80 border-slate-700 hover:border-slate-600 text-slate-300">
                            <span class="text-[10px] font-extrabold block uppercase tracking-wider text-slate-500">Stage 2</span>
                            <span class="font-bold text-sm block mt-0.5">2. Mix Snowballs</span>
                            <span class="text-[11px] text-slate-400 mt-1 block">Animate physics bowl</span>
                        </button>

                        <button id="stage-btn-REVEAL" onclick="hostDistributeNotes()" class="p-3.5 rounded-xl border-2 text-left transition-all bg-slate-800/80 border-slate-700 hover:border-slate-600 text-slate-300">
                            <span class="text-[10px] font-extrabold block uppercase tracking-wider text-slate-500">Stage 3</span>
                            <span class="font-bold text-sm block mt-0.5">3. Distribute Notes</span>
                            <span class="text-[11px] text-slate-400 mt-1 block">Non-self randomized swap</span>
                        </button>

                        <button id="stage-btn-REFLECTION" onclick="hostUpdateStage('REFLECTION')" class="p-3.5 rounded-xl border-2 text-left transition-all bg-slate-800/80 border-slate-700 hover:border-slate-600 text-slate-300">
                            <span class="text-[10px] font-extrabold block uppercase tracking-wider text-slate-500">Stage 4</span>
                            <span class="font-bold text-sm block mt-0.5">4. Group Debrief</span>
                            <span class="text-[11px] text-slate-400 mt-1 block">Discussion prompts</span>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <section id="step-1" class="hidden w-full transition-all duration-500">
            <div class="text-center max-w-xl mx-auto mb-6">
                <span class="px-3 py-1 bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 rounded-full text-xs font-bold uppercase tracking-wider mb-2 inline-block">100% Anonymous</span>
                <h2 class="text-2xl md:text-3xl font-extrabold text-white tracking-tight">Write Your Thoughts</h2>
                <p class="text-slate-400 text-xs md:text-sm mt-1">Your response will be crumpled into a virtual snowball and randomly swapped with a peer.</p>
            </div>

            <div id="note-form-card" class="paper-card rounded-2xl p-6 md:p-8 relative transition-all duration-500">
                <div class="absolute -top-3 left-1/2 -translate-x-1/2 w-32 h-7 bg-amber-200/80 backdrop-blur-sm border border-amber-300/60 rotate-1 shadow-sm rounded-sm pointer-events-none"></div>

                <form id="note-form" onsubmit="handleNoteSubmit(event)" class="space-y-5">
                    <div>
                        <label for="excited-text" class="flex items-center gap-2 text-xs md:text-sm font-bold text-emerald-900 mb-1.5">
                            <span class="text-base">🌟</span>
                            What is 1 thing you are excited or hopeful about?
                        </label>
                        <textarea id="excited-text" required rows="3" maxlength="280" placeholder="e.g., Passing my clinical exam, seeing family over break, starting a new project..." class="w-full p-3 rounded-xl border border-stone-300 focus:border-emerald-500 focus:ring-2 focus:ring-emerald-200 transition-all text-slate-900 text-sm resize-none bg-white placeholder-slate-400"></textarea>
                    </div>

                    <div>
                        <label for="anxious-text" class="flex items-center gap-2 text-xs md:text-sm font-bold text-amber-900 mb-1.5">
                            <span class="text-base">💭</span>
                            What is 1 thing you feel self-conscious or anxious about?
                        </label>
                        <textarea id="anxious-text" required rows="3" maxlength="280" placeholder="e.g., Speaking up during group discussions, imposter syndrome, balancing workload..." class="w-full p-3 rounded-xl border border-stone-300 focus:border-amber-500 focus:ring-2 focus:ring-amber-200 transition-all text-slate-900 text-sm resize-none bg-white placeholder-slate-400"></textarea>
                    </div>

                    <button type="submit" id="submit-btn" class="w-full py-3.5 px-6 bg-gradient-to-r from-indigo-600 to-cyan-600 hover:from-indigo-700 hover:to-cyan-700 text-white font-bold rounded-xl shadow-lg transition-all flex items-center justify-center gap-2">
                        <span>Crumple & Toss Into Bowl</span>
                        <i class="ph-bold ph-paper-plane-tilt text-lg"></i>
                    </button>
                </form>

                <div id="submitted-confirmation" class="hidden text-center py-8 space-y-3">
                    <div class="w-14 h-14 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-3xl mx-auto shadow-inner">
                        <i class="ph-bold ph-check"></i>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900">Your snowball is in the bowl!</h3>
                    <p class="text-xs text-slate-600 max-w-sm mx-auto">Waiting for your facilitator to start mixing snowballs across all connected devices...</p>
                </div>
            </div>
        </section>

        <section id="step-2" class="hidden w-full flex flex-col items-center justify-center transition-all duration-500">
            <div class="text-center max-w-md mx-auto mb-3">
                <span class="px-3 py-1 bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 rounded-full text-xs font-bold uppercase tracking-wider mb-2 inline-block animate-pulse">Live Bowl Active</span>
                <h2 class="text-2xl font-extrabold text-white">Mixing Snowballs!</h2>
                <p class="text-xs text-slate-400 mt-1">All group thoughts are being tossed and mixed together in the bowl.</p>
            </div>

            <!-- Physics Bowl Canvas -->
            <div class="relative w-full max-w-lg h-64 md:h-72 my-2 flex items-center justify-center">
                <div class="absolute inset-0 rounded-b-[120px] rounded-t-[30px] bg-gradient-to-b from-slate-800/80 via-slate-900/90 to-indigo-950/90 border-4 border-slate-700/80 shadow-2xl bowl-shadow backdrop-blur-md overflow-hidden">
                    <div class="absolute top-3 left-6 right-6 h-5 rounded-full bg-gradient-to-b from-white/10 to-transparent pointer-events-none"></div>
                </div>

                <canvas id="bowl-canvas" class="absolute inset-0 w-full h-full z-10 cursor-grab active:cursor-grabbing"></canvas>
            </div>

            <p class="text-xs text-slate-400 mt-2 flex items-center gap-1.5">
                <i class="ph-bold ph-hand-swipe text-cyan-400 text-sm"></i>
                <span>Drag mouse or touch across bowl to swirl virtual snowballs</span>
            </p>
        </section>

        <section id="step-3" class="hidden w-full max-w-2xl transition-all duration-500">
            <div id="unfolded-paper" class="paper-card rounded-2xl p-6 md:p-8 relative shadow-2xl mb-6">
                <div class="flex items-center justify-between border-b border-stone-300 pb-3 mb-5">
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
                        <span class="w-3 h-3 rounded-full bg-amber-500"></span>
                        <span class="text-xs font-bold text-stone-500 uppercase tracking-widest">Anonymous Peer Thought</span>
                    </div>
                    <span id="note-id-tag" class="text-xs font-mono px-2 py-0.5 rounded bg-stone-200 text-stone-700 font-semibold">#SNOWBALL</span>
                </div>

                <div class="space-y-4">
                    <div class="bg-emerald-50/80 rounded-xl p-4 border border-emerald-200/80">
                        <div class="flex items-center gap-1.5 mb-1 text-xs font-bold uppercase tracking-wider text-emerald-900">
                            <span>🌟</span>
                            <span>Excited or Hopeful About:</span>
                        </div>
                        <p id="drawn-excited-text" class="handwritten text-xl md:text-2xl text-slate-900 leading-relaxed">
                            "Loading snowball..."
                        </p>
                    </div>

                    <div class="bg-amber-50/80 rounded-xl p-4 border border-amber-200/80">
                        <div class="flex items-center gap-1.5 mb-1 text-xs font-bold uppercase tracking-wider text-amber-900">
                            <span>💭</span>
                            <span>Self-Conscious or Anxious About:</span>
                        </div>
                        <p id="drawn-anxious-text" class="handwritten text-xl md:text-2xl text-slate-900 leading-relaxed">
                            "Loading snowball..."
                        </p>
                    </div>
                </div>

                <!-- Real-Time Empathy Reactions -->
                <div class="mt-6 pt-4 border-t border-stone-300 flex flex-wrap items-center justify-between gap-3">
                    <span class="text-xs font-medium text-stone-600">Send silent empathy to this snowball:</span>
                    <div class="flex items-center gap-2">
                        <button onclick="sendEmpathy('relate')" class="px-3.5 py-1.5 bg-white border border-stone-300 hover:border-rose-400 rounded-full text-xs font-semibold text-stone-700 hover:text-rose-600 transition-all flex items-center gap-1.5 shadow-sm active:scale-95">
                            <span>❤️</span>
                            <span>I relate to this</span>
                            <span id="empathy-count-relate" class="font-bold text-stone-400 ml-1">0</span>
                        </button>
                        <button onclick="sendEmpathy('support')" class="px-3.5 py-1.5 bg-white border border-stone-300 hover:border-amber-400 rounded-full text-xs font-semibold text-stone-700 hover:text-amber-600 transition-all flex items-center gap-1.5 shadow-sm active:scale-95">
                            <span>💪</span>
                            <span>You got this!</span>
                            <span id="empathy-count-support" class="font-bold text-stone-400 ml-1">0</span>
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <section id="step-4" class="hidden w-full max-w-2xl transition-all duration-500">
            <div class="glass-panel rounded-2xl p-6 shadow-2xl border border-slate-700">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-300 border border-amber-500/30 flex items-center justify-center text-xl">
                        <i class="ph-bold ph-chats-teardrop"></i>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-white">Group Reflection & Processing</h3>
                        <p class="text-xs text-slate-400">Counseling debrief questions for classroom & group settings.</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
                    <div class="p-4 rounded-xl bg-slate-900/80 border border-slate-700 text-slate-300 space-y-1">
                        <span class="font-bold text-cyan-300 block text-sm">🔍 Universalization</span>
                        <p>How did reading a peer's self-conscious thought shift your perception of your own anxieties?</p>
                    </div>
                    <div class="p-4 rounded-xl bg-slate-900/80 border border-slate-700 text-slate-300 space-y-1">
                        <span class="font-bold text-purple-300 block text-sm">🤝 Psychological Safety</span>
                        <p>Why is externalizing distress into a physical metaphor (crumpling/tossing) effective in group work?</p>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, setDoc, getDoc, updateDoc, onSnapshot, collection, runTransaction } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Global Environment Variables
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'virtual-snowball-toss';
        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : null;
        const initialAuthToken = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null;

        let db = null;
        let auth = null;
        let currentUser = null;

        // Active State Variables
        let currentRoomCode = null;
        let isHost = false;
        let roomUnsubscribe = null;
        let participantsUnsubscribe = null;
        let notesUnsubscribe = null;
        let assignedNoteId = null;
        let isSandbox = false;

        // Preset Fallback Responses for Solo Sandbox Mode
        const SANDBOX_PRESETS = [
            { id: "DEMO-1", excited: "Completing my school counseling practicum hours!", anxious: "Balancing clinical notes with full-time course deadlines." },
            { id: "DEMO-2", excited: "Presenting my SEL group curriculum proposal.", anxious: "Imposter syndrome during clinical supervision sessions." },
            { id: "DEMO-3", excited: "Learning cognitive defusion techniques in ACT.", anxious: "Managing emotional burnout when working with high-risk cases." }
        ];

        async function ensureAuth() {
            if (currentUser) return currentUser;

            if (!firebaseConfig) {
                enableSandboxMode();
                return null;
            }

            try {
                const app = initializeApp(firebaseConfig);
                db = getFirestore(app);
                auth = getAuth(app);

                if (initialAuthToken) {
                    const userCred = await signInWithCustomToken(auth, initialAuthToken);
                    currentUser = userCred.user;
                } else {
                    const userCred = await signInAnonymously(auth);
                    currentUser = userCred.user;
                }
                return currentUser;
            } catch (err) {
                console.warn("Firebase Auth Error, defaulting to sandbox:", err);
                enableSandboxMode();
                return null;
            }
        }

        function enableSandboxMode() {
            isSandbox = true;
            document.getElementById('sandbox-banner').classList.remove('hidden');
            document.getElementById('header-subtitle').textContent = "Offline Sandbox Simulation";
        }

        // Firestore Path Resolvers
        function roomRef(code) {
            return doc(db, 'artifacts', appId, 'public', 'data', 'rooms', code.toUpperCase());
        }
        function participantCollRef(code) {
            return collection(db, 'artifacts', appId, 'public', 'data', 'rooms', code.toUpperCase(), 'participants');
        }
        function noteCollRef(code) {
            return collection(db, 'artifacts', appId, 'public', 'data', 'rooms', code.toUpperCase(), 'notes');
        }

        window.createRoom = async function() {
            const user = await ensureAuth();
            const code = Math.random().toString(36).substring(2, 6).toUpperCase();
            currentRoomCode = code;
            isHost = true;

            if (!isSandbox && user) {
                try {
                    await setDoc(roomRef(code), {
                        code: code,
                        hostUid: user.uid,
                        stage: 'SUBMISSION', // SUBMISSION | MIXING | REVEAL | REFLECTION
                        createdAt: Date.now(),
                        assignments: {}
                    });
                    subscribeToRoom(code);
                } catch (err) {
                    console.error("Error creating room doc:", err);
                    enableSandboxMode();
                }
            }

            showHostDashboard(code);
        };

        window.joinRoomFromInput = async function() {
            const input = document.getElementById('join-code-input').value.trim();
            if (!input || input.length !== 4) {
                alert("Please enter a valid 4-letter Room Code.");
                return;
            }
            await window.joinRoom(input);
        };

        window.joinRoom = async function(code) {
            const cleanCode = code.toUpperCase();
            const user = await ensureAuth();

            currentRoomCode = cleanCode;
            isHost = false;

            if (!isSandbox && user) {
                try {
                    const rDoc = await getDoc(roomRef(cleanCode));
                    if (!rDoc.exists()) {
                        alert("Room not found. Please verify the code.");
                        return;
                    }

                    // Register participant presence
                    const pRef = doc(participantCollRef(cleanCode), user.uid);
                    await setDoc(pRef, {
                        uid: user.uid,
                        joinedAt: Date.now(),
                        submitted: false
                    }, { merge: true });

                    subscribeToRoom(cleanCode);
                } catch (err) {
                    console.error("Error joining room:", err);
                    enableSandboxMode();
                }
            }

            showParticipantView(cleanCode);
        };

        window.startSandboxMode = function() {
            enableSandboxMode();
            window.createRoom();
        };

        function subscribeToRoom(code) {
            if (roomUnsubscribe) roomUnsubscribe();
            if (participantsUnsubscribe) participantsUnsubscribe();
            if (notesUnsubscribe) notesUnsubscribe();

            // 1. Room State Live Sync
            roomUnsubscribe = onSnapshot(roomRef(code), (snap) => {
                if (!snap.exists()) return;
                const data = snap.data();
                syncRoomStageUI(data.stage, data.assignments || {});
            }, (err) => console.error("Room listener err:", err));

            // 2. Host Participant Count Live Sync
            if (isHost) {
                participantsUnsubscribe = onSnapshot(participantCollRef(code), (snap) => {
                    document.getElementById('host-participants-count').textContent = snap.size;
                }, (err) => console.error("Participant listener err:", err));

                notesUnsubscribe = onSnapshot(noteCollRef(code), (snap) => {
                    document.getElementById('host-submitted-count').textContent = snap.size;
                }, (err) => console.error("Notes listener err:", err));
            } else {
                // Participant listening to notes count for bowl canvas
                notesUnsubscribe = onSnapshot(noteCollRef(code), (snap) => {
                    updateCanvasBalls(snap.size);
                }, (err) => console.error("Participant note count err:", err));
            }
        }

        window.hostUpdateStage = async function(newStage) {
            if (isSandbox) {
                syncRoomStageUI(newStage, {});
                return;
            }
            if (!currentRoomCode) return;
            try {
                await updateDoc(roomRef(currentRoomCode), { stage: newStage });
            } catch (err) {
                console.error("Failed to update stage:", err);
            }
        };

        window.hostDistributeNotes = async function() {
            if (isSandbox) {
                syncRoomStageUI('REVEAL', {});
                return;
            }

            try {
                // Fetch all submitted notes
                const notesSnap = await getDoc(collection(db, 'artifacts', appId, 'public', 'data', 'rooms', currentRoomCode, 'notes'));
                const notes = [];
                notesSnap.forEach(d => notes.push({ id: d.id, ...d.data() }));

                if (notes.length === 0) {
                    alert("No notes submitted yet!");
                    return;
                }

                // Compute Derangement (Nobody gets their own note)
                const assignments = computeDerangements(notes);

                await updateDoc(roomRef(currentRoomCode), {
                    stage: 'REVEAL',
                    assignments: assignments
                });
            } catch (err) {
                console.error("Distribution error:", err);
            }
        };

        function computeDerangements(notes) {
            const authorUids = notes.map(n => n.authorUid);
            let shuffled = [...notes];

            if (notes.length > 1) {
                let attempts = 0;
                let valid = false;
                while (!valid && attempts < 100) {
                    attempts++;
                    shuffled = [...notes].sort(() => Math.random() - 0.5);
                    valid = shuffled.every((note, idx) => note.authorUid !== authorUids[idx]);
                }
            }

            const map = {};
            authorUids.forEach((uid, idx) => {
                map[uid] = shuffled[idx].id;
            });
            return map;
        }

        function syncRoomStageUI(stage, assignments = {}) {
            // Hide all step sections
            document.getElementById('step-1').classList.add('hidden');
            document.getElementById('step-2').classList.add('hidden');
            document.getElementById('step-3').classList.add('hidden');
            document.getElementById('step-4').classList.add('hidden');

            if (isHost) {
                ['SUBMISSION', 'MIXING', 'REVEAL', 'REFLECTION'].forEach(s => {
                    const btn = document.getElementById(`stage-btn-${s}`);
                    if (!btn) return;
                    if (s === stage) {
                        btn.className = "p-3.5 rounded-xl border-2 text-left transition-all bg-indigo-600/30 border-indigo-500 text-indigo-200";
                    } else {
                        btn.className = "p-3.5 rounded-xl border-2 text-left transition-all bg-slate-800/80 border-slate-700 hover:border-slate-600 text-slate-300";
                    }
                });
            }

            if (stage === 'SUBMISSION') {
                if (!isHost) document.getElementById('step-1').classList.remove('hidden');
            } else if (stage === 'MIXING') {
                if (!isHost) {
                    document.getElementById('step-2').classList.remove('hidden');
                    initCanvas();
                }
            } else if (stage === 'REVEAL') {
                if (!isHost) {
                    document.getElementById('step-3').classList.remove('hidden');
                    loadAssignedNote(assignments);
                }
            } else if (stage === 'REFLECTION') {
                document.getElementById('step-4').classList.remove('hidden');
            }
        }

        window.handleNoteSubmit = async function(e) {
            e.preventDefault();
            const excited = document.getElementById('excited-text').value.trim();
            const anxious = document.getElementById('anxious-text').value.trim();

            if (!excited || !anxious) return;

            const formCard = document.getElementById('note-form-card');
            formCard.classList.add('paper-crumpled');

            setTimeout(async () => {
                if (!isSandbox && currentUser && currentRoomCode) {
                    try {
                        const noteDoc = doc(noteCollRef(currentRoomCode), currentUser.uid);
                        await setDoc(noteDoc, {
                            authorUid: currentUser.uid,
                            excited: excited,
                            anxious: anxious,
                            relateCount: 0,
                            supportCount: 0,
                            createdAt: Date.now()
                        });

                        // Update participant submitted status
                        const pRef = doc(participantCollRef(currentRoomCode), currentUser.uid);
                        await updateDoc(pRef, { submitted: true });
                    } catch (err) {
                        console.error("Error submitting note:", err);
                    }
                }

                document.getElementById('note-form').classList.add('hidden');
                document.getElementById('submitted-confirmation').classList.remove('hidden');
                formCard.classList.remove('paper-crumpled');
            }, 750);
        };

        async function loadAssignedNote(assignments) {
            const uid = currentUser ? currentUser.uid : 'sandbox-uid';
            assignedNoteId = assignments[uid];

            if (isSandbox || !assignedNoteId) {
                const preset = SANDBOX_PRESETS[Math.floor(Math.random() * SANDBOX_PRESETS.length)];
                renderUnfoldedNote(preset);
                return;
            }

            try {
                const nRef = doc(noteCollRef(currentRoomCode), assignedNoteId);
                const snap = await getDoc(nRef);
                if (snap.exists()) {
                    renderUnfoldedNote({ id: snap.id, ...snap.data() });

                    // Subscribe to real-time empathy reaction counter on this note
                    onSnapshot(nRef, (docSnap) => {
                        if (!docSnap.exists()) return;
                        const data = docSnap.data();
                        document.getElementById('empathy-count-relate').textContent = data.relateCount || 0;
                        document.getElementById('empathy-count-support').textContent = data.supportCount || 0;
                    });
                }
            } catch (err) {
                console.error("Error loading note:", err);
            }
        }

        function renderUnfoldedNote(note) {
            document.getElementById('drawn-excited-text').textContent = `"${note.excited}"`;
            document.getElementById('drawn-anxious-text').textContent = `"${note.anxious}"`;
            document.getElementById('note-id-tag').textContent = `#${note.id.substring(0, 6)}`;

            const paper = document.getElementById('unfolded-paper');
            paper.classList.remove('paper-unfold');
            void paper.offsetWidth;
            paper.classList.add('paper-unfold');

            confetti({ particleCount: 35, spread: 70, origin: { y: 0.6 } });
        }

        window.sendEmpathy = async function(type) {
            const countEl = document.getElementById(`empathy-count-${type}`);
            countEl.textContent = parseInt(countEl.textContent, 10) + 1;

            if (!isSandbox && currentRoomCode && assignedNoteId) {
                try {
                    const nRef = doc(noteCollRef(currentRoomCode), assignedNoteId);
                    const field = type === 'relate' ? 'relateCount' : 'supportCount';
                    await runTransaction(db, async (tx) => {
                        const docSnap = await tx.get(nRef);
                        if (!docSnap.exists()) return;
                        const curr = docSnap.data()[field] || 0;
                        tx.update(nRef, { [field]: curr + 1 });
                    });
                } catch (err) {
                    console.error("Empathy tx error:", err);
                }
            }
        };

        let canvas, ctx, balls = [];
        class PaperBall {
            constructor(w, h) {
                this.x = w / 2 + (Math.random() - 0.5) * 80;
                this.y = h * 0.4;
                this.radius = 14 + Math.random() * 4;
                this.vx = (Math.random() - 0.5) * 5;
                this.vy = (Math.random() - 0.5) * 5;
                this.rotation = Math.random() * Math.PI * 2;
                this.color = ['#fafaf9', '#fef3c7', '#e0f2fe', '#f0fdf4'][Math.floor(Math.random() * 4)];
            }
            update(w, h) {
                this.x += this.vx; this.y += this.vy;
                this.vx *= 0.98; this.vy *= 0.98; this.vy += 0.12;
                const dx = this.x - w / 2, dy = this.y - h * 0.35;
                if (Math.sqrt(dx*dx + dy*dy) + this.radius > w * 0.38) {
                    const angle = Math.atan2(dy, dx);
                    this.x = w / 2 + Math.cos(angle) * (w * 0.38 - this.radius);
                    this.y = h * 0.35 + Math.sin(angle) * (w * 0.38 - this.radius);
                    this.vx *= -0.6; this.vy *= -0.6;
                }
            }
            draw(c) {
                c.save(); c.translate(this.x, this.y); c.rotate(this.rotation);
                c.beginPath(); c.arc(0, 0, this.radius, 0, Math.PI * 2);
                c.fillStyle = this.color; c.fill();
                c.strokeStyle = '#94a3b8'; c.lineWidth = 1.5; c.stroke();
                c.restore();
            }
        }

        function initCanvas() {
            canvas = document.getElementById('bowl-canvas');
            if (!canvas) return;
            ctx = canvas.getContext('2d');
            const rect = canvas.parentElement.getBoundingClientRect();
            canvas.width = rect.width; canvas.height = rect.height;
            updateCanvasBalls(8);
            animateCanvas();
        }

        function updateCanvasBalls(count) {
            if (!canvas) return;
            balls = [];
            const num = Math.min(Math.max(count || 6, 5), 30);
            for(let i = 0; i < num; i++) {
                balls.push(new PaperBall(canvas.width, canvas.height));
            }
        }

        function animateCanvas() {
            if (!ctx || !canvas) return;
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            balls.forEach(b => { b.update(canvas.width, canvas.height); b.draw(ctx); });
            requestAnimationFrame(animateCanvas);
        }

        function showHostDashboard(code) {
            document.getElementById('lobby-view').classList.add('hidden');
            document.getElementById('host-view').classList.remove('hidden');
            document.getElementById('room-status-bar').classList.remove('hidden');
            document.getElementById('header-room-code').textContent = code;
            document.getElementById('host-code-display').textContent = code;
        }

        function showParticipantView(code) {
            document.getElementById('lobby-view').classList.add('hidden');
            document.getElementById('step-1').classList.remove('hidden');
            document.getElementById('room-status-bar').classList.remove('hidden');
            document.getElementById('header-room-code').textContent = code;
        }

        window.leaveSession = function() {
            location.reload();
        };
    </script>
</body>
